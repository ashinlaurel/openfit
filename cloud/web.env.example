# Configuration contract for the planned private web deployment.
# The current cloud server does not consume these web settings yet.
# Keep the filled file on the VM; never expose secrets through VITE_* variables.
OPENFIT_WEB_ORIGIN=https://fit.example.com
OPENFIT_OWNER_EMAIL=you@example.com
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
# Register this exact address in the Google OAuth Web application's redirect URIs.
GOOGLE_REDIRECT_URI=https://fit.example.com/auth/google/callback

# Reuse the existing VM key. Changing it makes existing archives unreadable.
STORAGE_KEY=existing-vm-storage-key
# Dedicated server-side Open Gym credential, issued by pairing the owner's profile.
OPEN_GYM_API_URL=http://gym-api:3000
OPEN_GYM_TOKEN=server-device-token
